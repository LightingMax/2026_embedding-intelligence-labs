#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${ROOT_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"

command_name="${1:-demo}"
if [[ $# -gt 0 ]]; then shift; fi

case "${command_name}" in
  demo)
    python3 -m embodied_book_labs.cli run "$@"
    ;;
  chapter)
    python3 -m embodied_book_labs.cli chapter "$@"
    ;;
  serve)
    python3 -m embodied_book_labs.cli serve "$@"
    ;;
  test)
    python3 -m unittest discover -s "${ROOT_DIR}/tests" -v
    ;;
  isaac)
    subcommand="${1:-doctor}"
    if [[ $# -gt 0 ]]; then shift; fi
    "${ROOT_DIR}/scripts/isaac_${subcommand}.sh" "$@"
    ;;
  *)
    echo "用法: ./lab {demo|chapter N|serve|test|isaac doctor|isaac setup|isaac run}" >&2
    exit 2
    ;;
esac
